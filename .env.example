# ============================================
# AutoOffice — 配置文件
# 复制为 .env 后修改
# ============================================

# 运行模式: demo (默认, 无需 API Key) | real (需要配置 AI 提供商)
OA_MODE=demo

# --- AI 提供商 (mode=real 时需至少配置一个) ---

# OpenAI 兼容接口 (支持 OpenAI / DeepSeek / Moonshot / 硅基流动 等)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 示例：DeepSeek
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 示例：硅基流动 (SiliconFlow)
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# Ollama (本地部署, 无需 API Key)
# 需先启动: ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 通义千问 (阿里云 DashScope)
# 需先申请 API Key: https://dashscope.aliyun.com
DASHSCOPE_API_KEY=
TONGYI_MODEL=qwen2.5-7b-instruct
